@inject IWebHostEnvironment HostEnvironment

<!DOCTYPE html>
<html lang="da">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <nav class="app-navigation" aria-label="Hovedmenu">
        <a class="app-brand" href="/">Feedr</a>
        <a href="/">Database</a>
        <a href="/files">Filer på serveren</a>
        <a href="/client/index.html" data-enhance-nav="false">Filklient</a>
        @if (HostEnvironment.IsDevelopment())
        {
            <a href="/swagger" data-enhance-nav="false">Test API</a>
        }
    </nav>
    <Routes @rendermode="InteractiveServer" />

    <div id="blazor-error-ui" class="alert alert-danger fixed-bottom mb-0" data-nosnippet>
        Der opstod en fejl.
        <a href="." class="reload">Genindlæs siden</a>
        <button type="button" class="dismiss" aria-label="Luk fejlbeskeden">×</button>
    </div>
    <script>
        // Åbn browserens indbyggede dialogvindue.
        window.showRecordEditor = dialog => dialog.showModal();
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
