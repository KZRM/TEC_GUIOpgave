@page "/"

<!DOCTYPE html>
<html lang="da">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    @* Forsiden vises direkte. InteractiveServer gør dropdowns og knapper interaktive. *@
    <Home @rendermode="InteractiveServer" />

    <div id="blazor-error-ui" class="alert alert-danger fixed-bottom mb-0" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
    <script>
        // Åbn browserens indbyggede dialogvindue.
        window.showRecordEditor = dialog => dialog.showModal();
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
