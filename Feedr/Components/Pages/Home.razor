@* 1.2: Vi bruger Blazors indbyggede delvise rendering. InteractiveServer sættes i App.razor. *@
@inject Feedr.DBAccess.Repository Repository
@page "/"
@inject Feedr.State.UiState State

@* 2.2: Sprogvalget ændrer teksterne. Den valgte tabel og dens data bevares. *@
<PageTitle>@Title</PageTitle>

@* 2.1–2.2: Sprogmenu med billede. @bind gemmer valget i brugerens UiState. *@
<header class="d-flex justify-content-end align-items-center gap-2 p-3" role="toolbar" aria-label="Sprogvalg">
    <LanguageSelector @bind-Language="State.Language" />
</header>

<main class="px-3">
    <h1>@Title</h1>
    <div class="splitContainer">
        <div class="baseContainer">
            <DBService @key="overviewVersion" />
        </div>
        <div class="baseContainer">
            <p>@Translations.ServiceStatus(State.Language)</p>
            @* 1.2: @bind gemmer tabelvalget. Blazor opdaterer derefter visningen. *@
            <p>
                <label for="table">Tabel:</label>
                <select id="table" @bind="selectedTable">
                    <option value="">Vælg en tabel</option>
                    @foreach (var table in tables)
                    {
                        <option value="@table">@table</option>
                    }
                </select>
            </p>

            @* 1.3: Vores partial view. 
            Når selectedTable ændres, ændres @key, og Blazor erstatter den gamle DatabaseTable med en ny. *@
            <DatabaseTable @key="selectedTable"
                           TableName="@selectedTable"
                           Language="@State.Language"
                           DataChanged="RefreshOverview" />
        </div>
    </div>
</main>

@code {
    private string selectedTable = "";
    private string[] tables = [];

    // 2.2: Titlen følger sprogvalget, som også sendes til DatabaseTable.
    private string Title => Translations.DatabaseOverview(State.Language);

    protected override void OnInitialized()
    {
        tables = Repository.GetTableNames();
    }
    private int overviewVersion;

    // Ny key får DBService til at blive oprettet igen.
    private void RefreshOverview() { overviewVersion++; }
}
